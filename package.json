{
  "name": "payrollpro-desktop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd nomina && npm run dev",
    "dev:front": "cd nomina-front && npm run dev",
    "dev:electron": "electron .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:front\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "lint": "cd nomina-front && npx eslint src --ext .ts,.tsx --fix || true",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^8.2.0",
    "electron": "^26.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "wait-on": "^7.0.1"
  }
}
